{
  "comments": {
    "blockComment": [
      "{#",
      "#}"
    ]
  },
  "brackets": [
    [
      "{{",
      "}}"
    ],
    [
      "{%",
      "%}"
    ],
    [
      "{#",
      "#}"
    ],
    [
      "<!--",
      "-->"
    ],
    [
      "<",
      ">"
    ],
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{{",
      "close": " }}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{%",
      "close": " %}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{#",
      "close": " #}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "<!--",
      "close": "-->",
      "notIn": [
        "comment",
        "string"
      ]
    }
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "'",
      "'"
    ],
    [
      "\"",
      "\""
    ],
    [
      "<",
      ">"
    ]
  ],
  "colorizedBracketPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\$\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\s]+)",
  "folding": {
    "markers": {
      "start": "^\\s*(\\{%-?\\s*(if|unless|case|for|capture|form|comment|schema)\\b|<!--\\s*#region\\b)",
      "end": "^\\s*(\\{%-?\\s*(endif|endunless|endcase|endfor|endcapture|endform|endcomment|endschema)\\b|<!--\\s*#endregion\\b)"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "(\\{%-?\\s*(if|elsif|else|unless|case|when|for|capture|form|comment)\\b[^%]*-?%\\}(?!.*\\{%-?\\s*end(if|unless|case|for|capture|form|comment)))|(<(?!(?:area|base|br|col|embed|hr|img|input|keygen|link|menuitem|meta|param|source|track|wbr)\\b)([-_\\.A-Za-z0-9]+)(?=\\s|>)\\b[^>]*>(?!.*</\\3>)\\s*$)",
    "decreaseIndentPattern": "^\\s*(\\{%-?\\s*(elsif|else|when|endif|endunless|endcase|endfor|endcapture|endform|endcomment)\\b|</[-_\\.A-Za-z0-9]+\\b[^>]*>)"
  }
}
